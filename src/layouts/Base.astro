---
import { ViewTransitions } from 'astro:transitions';
import Sidebar from '../components/Sidebar.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 传入即为二级界面：值为界面标签（如 "博客 · 分类"），顶部会显示常驻提示条 */
  secondary?: string;
}

const {
  title = 'Loky · 个人主页',
  description = 'Loky 的个人网站 — iOS 开发者，用 Objective-C 与 UIKit 打磨手艺。',
  secondary,
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ViewTransitions />
    <title>{title}</title>
  </head>
  <body>
    {
      secondary && (
        <div class="secondary-bar">
          <span class="sec-badge">二级界面</span>
          <span class="sec-label">{secondary}</span>
          <a class="sec-back" href="/">
            <span aria-hidden="true">←</span> 返回一级界面
          </a>
        </div>
      )
    }
    <Sidebar />
    <main>
      <slot />
    </main>

    {
      secondary && (
        <style>
          /* —— 二级界面提示条：常驻顶部，明显区别于一级浏览 —— */
          .secondary-bar {
            position: sticky;
            top: 0;
            z-index: 30;
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 10px 68px 10px 20px;
            background: rgba(26, 16, 48, 0.78);
            -webkit-backdrop-filter: blur(14px);
            backdrop-filter: blur(14px);
            border-bottom: 1px solid rgba(255, 138, 26, 0.4);
          }

          .sec-badge {
            font-size: 11px;
            font-weight: 750;
            letter-spacing: 0.18em;
            color: #150d26;
            background: linear-gradient(135deg, #ffa042, #ff8c1a);
            padding: 3px 10px;
            clip-path: polygon(
              7px 0,
              100% 0,
              100% calc(100% - 7px),
              calc(100% - 7px) 100%,
              0 100%,
              0 7px
            );
          }

          .sec-label {
            font-size: 13px;
            letter-spacing: 0.14em;
            color: var(--text-secondary);
          }

          .sec-back {
            margin-left: auto;
            padding: 6px 14px;
            font-size: 12.5px;
            font-weight: 650;
            letter-spacing: 0.1em;
            color: #ffa042;
            border: 1px solid rgba(255, 138, 26, 0.55);
            background: rgba(30, 16, 54, 0.6);
            clip-path: polygon(
              8px 0,
              100% 0,
              100% calc(100% - 8px),
              calc(100% - 8px) 100%,
              0 100%,
              0 8px
            );
            transition: border-color 0.3s ease, background 0.3s ease;
          }

          .sec-back:hover {
            border-color: rgba(255, 160, 66, 0.95);
            background: rgba(46, 24, 80, 0.85);
          }

          @media (max-width: 640px) {
            .secondary-bar {
              padding: 9px 64px 9px 14px;
              gap: 10px;
            }
            .sec-label {
              font-size: 12px;
              letter-spacing: 0.08em;
            }
            .sec-back {
              padding: 5px 10px;
            }
          }
        </style>
      )
    }

    <script>
      // 滚动 reveal：进入视口的元素依次浮现（Apple 风格错峰）
      const initReveal = () => {
        const els = document.querySelectorAll('.reveal:not(.in-view)');
        if (!('IntersectionObserver' in window)) {
          els.forEach((el) => el.classList.add('in-view'));
          return;
        }
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('in-view');
                io.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.15, rootMargin: '0px 0px -48px 0px' }
        );
        els.forEach((el) => io.observe(el));
      };
      document.addEventListener('astro:page-load', initReveal);
    </script>
  </body>
</html>
