---
// 侧边栏：右上角按钮唤出 = 全站「二级界面目录」
// 首页内部导航已由左侧小字刻度导航（SectionRail）承担；
// 这里的每一项都是一个二级界面的入口（橙色信号），顶部是返回一级界面的入口（紫色信号）
const navItems = [
  { href: '/blog/', label: '博客', en: 'Blog', key: 'blog' },
  { href: '/projects/', label: '档案', en: 'Archive', key: 'projects' },
  { href: '/about/', label: '关于', en: 'About', key: 'about' },
  { href: '/uses/', label: '装备', en: 'Uses', key: 'uses' },
  { href: '/links/', label: '友链', en: 'Links', key: 'links' },
];

const path = Astro.url.pathname;
const activeKey =
  ['blog', 'projects', 'about', 'uses', 'links'].find((k) =>
    path.startsWith(`/${k === 'blog' ? 'blog' : k}`)
  ) ?? '';
---

<div id="sidebar-root">
  <button
    class="sidebar-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="sidebar-panel"
    aria-label="打开菜单"
  >
    <span class="bar"></span>
    <span class="bar"></span>
  </button>

  <div class="sidebar-backdrop" aria-hidden="true"></div>

  <aside class="sidebar-panel" id="sidebar-panel" aria-hidden="true" aria-label="站点导航">
    <p class="sidebar-label">Loky</p>

    {/* 一级界面入口（紫色信号） */}
    <a class="sec-home" href="/">
      <span class="dot dot-primary" aria-hidden="true"></span>
      <span class="sec-home-text">首页 · 一级界面</span>
    </a>

    <p class="sidebar-divider">二级界面</p>

    <nav>
      {
        navItems.map((item, i) => (
          <a
            class:list={['sidebar-link', { active: activeKey === item.key }]}
            href={item.href}
            style={`--i:${i}`}
            data-key={item.key}
            aria-current={activeKey === item.key ? 'page' : undefined}
          >
            <span class="link-dot" aria-hidden="true"></span>
            <span class="link-index">{String(i + 1).padStart(2, '0')}</span>
            <span class="link-text">
              {item.label}
              <small>{item.en}</small>
            </span>
            <span class="link-arrow" aria-hidden="true">→</span>
          </a>
        ))
      }
    </nav>
    <div class="sidebar-footer">
      <a href="https://github.com/Ribacha" target="_blank" rel="noopener noreferrer">
        GitHub @Ribacha ↗
      </a>
    </div>
  </aside>
</div>

<style>
  /* —— 唤出按钮（右上角固定）—— */
  .sidebar-toggle {
    position: fixed;
    top: 20px;
    right: 24px;
    z-index: 60;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--border);
    background: rgba(21, 13, 38, 0.65);
    -webkit-backdrop-filter: blur(16px) saturate(1.5);
    backdrop-filter: blur(16px) saturate(1.5);
    box-shadow: var(--shadow-card);
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: transform 0.4s var(--ease-out), background 0.3s ease,
      border-color 0.3s ease;
  }

  .sidebar-toggle:hover {
    transform: scale(1.06);
    border-color: rgba(255, 138, 26, 0.5);
  }

  .sidebar-toggle .bar {
    display: block;
    width: 20px;
    height: 2px;
    border-radius: 2px;
    background: var(--text);
    transition: transform 0.45s var(--ease-spring), opacity 0.3s ease;
  }

  /* 打开状态：两条横线交叉成 X */
  #sidebar-root.open .sidebar-toggle .bar:nth-child(1) {
    transform: translateY(4px) rotate(45deg);
  }
  #sidebar-root.open .sidebar-toggle .bar:nth-child(2) {
    transform: translateY(-4px) rotate(-45deg);
  }

  /* —— 毛玻璃遮罩 —— */
  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    z-index: 40;
    background: rgba(10, 4, 24, 0.55);
    -webkit-backdrop-filter: blur(10px);
    backdrop-filter: blur(10px);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.5s var(--ease-out), visibility 0s linear 0.5s;
  }

  #sidebar-root.open .sidebar-backdrop {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.5s var(--ease-out);
  }

  /* —— 侧边栏面板（右侧弹性滑入）—— */
  .sidebar-panel {
    position: fixed;
    top: 0;
    right: 0;
    z-index: 50;
    width: min(360px, 86vw);
    height: 100dvh;
    display: flex;
    flex-direction: column;
    padding: 96px 36px 36px;
    background: rgba(23, 14, 44, 0.88);
    -webkit-backdrop-filter: blur(28px) saturate(1.5);
    backdrop-filter: blur(28px) saturate(1.5);
    border-left: 1px solid var(--border);
    box-shadow: -20px 0 60px rgba(4, 0, 18, 0.5);
    transform: translateX(102%);
    visibility: hidden;
    transition:
      transform 0.65s var(--ease-spring),
      visibility 0s linear 0.65s;
  }

  #sidebar-root.open .sidebar-panel {
    transform: translateX(0);
    visibility: visible;
    transition: transform 0.65s var(--ease-spring);
  }

  .sidebar-label {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 28px;
  }

  /* —— 一级界面入口（紫色信号）—— */
  .sec-home {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 11px 14px;
    margin-bottom: 20px;
    border: 1px solid rgba(140, 90, 255, 0.35);
    border-radius: 10px;
    background: rgba(90, 60, 180, 0.1);
    color: var(--text);
    font-size: 13.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    transition: border-color 0.3s ease, background 0.3s ease, transform 0.4s var(--ease-out);
  }

  .sec-home:hover {
    transform: translateX(3px);
    border-color: rgba(140, 90, 255, 0.7);
    background: rgba(90, 60, 180, 0.18);
  }

  .dot {
    width: 8px;
    height: 8px;
    flex: none;
    border-radius: 2px;
  }

  .dot-primary {
    background: #8a6cf0;
    box-shadow: 0 0 8px rgba(140, 90, 255, 0.7);
  }

  /* —— 二级界面分隔标注 —— */
  .sidebar-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.3em;
    color: var(--text-tertiary);
    margin-bottom: 6px;
  }

  .sidebar-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }

  .sidebar-panel nav {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* 每个二级入口的橙色信号点 */
  .link-dot {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 2px;
    background: rgba(255, 138, 26, 0.4);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  .sidebar-link:hover .link-dot,
  .sidebar-link.active .link-dot {
    background: var(--accent);
    box-shadow: 0 0 8px rgba(255, 138, 26, 0.6);
  }

  .sidebar-link {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 4px;
    border-bottom: 1px solid var(--border);
    /* 逐条错峰浮现 */
    opacity: 0;
    transform: translateX(36px);
    transition: opacity 0.5s var(--ease-out), transform 0.5s var(--ease-out);
    transition-delay: 0s;
  }

  #sidebar-root.open .sidebar-link {
    opacity: 1;
    transform: none;
    transition-delay: calc(0.12s + var(--i) * 55ms);
  }

  .link-index {
    font-size: 12px;
    font-weight: 600;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }

  .link-text {
    flex: 1;
    display: flex;
    flex-direction: column;
    font-size: 21px;
    font-weight: 650;
    letter-spacing: -0.01em;
  }

  .link-text small {
    font-size: 12px;
    font-weight: 500;
    color: var(--text-tertiary);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .link-arrow {
    font-size: 16px;
    color: var(--text-tertiary);
    transition: transform 0.35s var(--ease-out), color 0.35s ease;
  }

  .sidebar-link:hover .link-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }

  /* 当前页面对应的分类：EVA 橙高亮 */
  .sidebar-link.active {
    border-bottom-color: rgba(255, 138, 26, 0.55);
  }

  .sidebar-link.active .link-text {
    color: var(--accent);
  }

  .sidebar-link.active .link-arrow {
    color: var(--accent);
    transform: translateX(4px);
  }

  .sidebar-footer {
    padding-top: 24px;
    font-size: 14px;
  }

  .sidebar-footer a {
    color: var(--text-secondary);
    transition: color 0.3s ease;
  }

  .sidebar-footer a:hover {
    color: var(--accent);
  }
</style>

<script>
  // 模块级保存 close 引用，保证 Esc 在任意页面状态都能关掉当前侧边栏
  let currentClose: (() => void) | null = null;
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && currentClose) currentClose();
  });

  const setupSidebar = () => {
    const root = document.getElementById('sidebar-root');
    const toggle = root?.querySelector<HTMLButtonElement>('.sidebar-toggle');
    const backdrop = root?.querySelector<HTMLElement>('.sidebar-backdrop');
    const panel = root?.querySelector<HTMLElement>('.sidebar-panel');
    if (!root || !toggle || !backdrop || !panel || toggle.dataset.bound) return;

    const open = () => {
      root.classList.add('open');
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', '关闭菜单');
      panel.setAttribute('aria-hidden', 'false');
      document.documentElement.classList.add('sidebar-open');
    };
    const close = () => {
      root.classList.remove('open');
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', '打开菜单');
      panel.setAttribute('aria-hidden', 'true');
      document.documentElement.classList.remove('sidebar-open');
    };

    currentClose = close;
    toggle.dataset.bound = '1';
    toggle.addEventListener('click', () => (root.classList.contains('open') ? close() : open()));
    backdrop.addEventListener('click', close);
    panel.querySelectorAll<HTMLAnchorElement>('a').forEach((a) => {
      a.addEventListener('click', () => close());
    });
  };

  document.addEventListener('astro:page-load', setupSidebar);
</script>
