---
import evaImg from '../assets/eva/eva01.jpg';

// EVA-01 组装机甲位：整图切成 5×5 装甲分片，
// 滚动经过身份面板时碎片从屏幕四周飞入、逐块"咔哒"落位。
// 进度由滚动位置驱动（可逆），非时间动画；无 JS / 减少动态时直接呈现完整机体。
const COLS = 5;
const ROWS = 5;
const CX = (COLS - 1) / 2;
const CY = (ROWS - 1) / 2;

const pieces = Array.from({ length: COLS * ROWS }, (_, i) => {
  const col = i % COLS;
  const row = Math.floor(i / COLS);
  // 距中心的归一化距离：核心先成型，外圈装甲后合拢
  const order = Math.hypot((col - CX) / COLS, (row - CY) / ROWS);
  return { i, col, row, order };
});
const maxOrder = Math.max(...pieces.map((p) => p.order));
---

<div class="eva" data-eva role="img" aria-label="EVA-01 初号机：随滚动逐块组装的机甲头部">
  <div class="eva-hud eva-hud-top">
    <span class="eva-name">EVA-01 <small>初号机</small></span>
    <span class="eva-status">
      <i class="eva-dot" aria-hidden="true"></i>
      <span data-eva-status>ACTIVE</span>
    </span>
  </div>

  <div class="eva-screen-wrap">
    <i class="eva-corner eva-corner-tl" aria-hidden="true"></i>
    <i class="eva-corner eva-corner-br" aria-hidden="true"></i>
    <div class="eva-screen" data-eva-screen style={`--eva-img: url('${evaImg.src}')`}>
      {
        pieces.map((p) => (
          <i
            class="eva-piece"
            data-eva-piece
            aria-hidden="true"
            style={`--cx:${p.col}; --cy:${p.row}; --o:${(p.order / maxOrder).toFixed(3)}`}
          />
        ))
      }
      <i class="eva-sweep" aria-hidden="true"></i>
    </div>
  </div>

  <div class="eva-hud eva-hud-bottom">
    <span>TEST TYPE · 试验机</span>
    <span class="eva-sync" data-eva-sync>SYNC 100%</span>
  </div>
</div>

<style>
  .eva {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  /* 机体后方的紫色辉光 */
  .eva::before {
    content: '';
    position: absolute;
    inset: -12% -18%;
    background: radial-gradient(circle, rgba(140, 90, 255, 0.16), transparent 68%);
    filter: blur(12px);
    pointer-events: none;
  }

  /* —— HUD：终端等宽小字 —— */
  .eva-hud {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--text-tertiary);
    position: relative;
    z-index: 1;
  }

  .eva-name {
    color: var(--accent);
    letter-spacing: 0.2em;
  }

  .eva-name small {
    font-size: 11px;
    font-weight: 550;
    color: var(--text-tertiary);
    letter-spacing: 0.14em;
    margin-left: 6px;
  }

  .eva-status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }

  .eva-dot {
    width: 7px;
    height: 7px;
    flex: none;
    background: var(--text-tertiary);
    clip-path: polygon(2px 0, 100% 0, 100% calc(100% - 2px), calc(100% - 2px) 100%, 0 100%, 0 2px);
    transition: background 0.3s ease, box-shadow 0.3s ease;
  }

  /* data-state：standby（待机）→ assembly（组装中）→ active（就绪） */
  .eva[data-state='assembly'] .eva-status,
  .eva[data-state='assembly'] .eva-sync {
    color: var(--accent);
  }

  .eva[data-state='assembly'] .eva-dot {
    background: var(--accent);
    animation: eva-blink 0.8s steps(2, start) infinite;
  }

  .eva[data-state='active'] .eva-status {
    color: var(--accent);
  }

  .eva[data-state='active'] .eva-dot {
    background: var(--accent);
    box-shadow: 0 0 10px rgba(255, 138, 26, 0.7);
  }

  @keyframes eva-blink {
    50% {
      opacity: 0.25;
    }
  }

  .eva-sync {
    font-variant-numeric: tabular-nums;
  }

  /* —— 屏幕：组装发生的地方 —— */
  .eva-screen-wrap {
    position: relative;
    z-index: 1;
  }

  .eva-corner {
    position: absolute;
    width: 22px;
    height: 22px;
    border: 2px solid rgba(255, 138, 26, 0.7);
    z-index: 2;
  }

  .eva-corner-tl {
    top: -7px;
    left: -7px;
    border-right: 0;
    border-bottom: 0;
  }

  .eva-corner-br {
    bottom: -7px;
    right: -7px;
    border-left: 0;
    border-top: 0;
  }

  .eva-screen {
    position: relative;
    aspect-ratio: 988 / 934;
    overflow: hidden;
    background: #2f2b50;
    border: 1px solid rgba(190, 160, 255, 0.24);
    box-shadow: 0 24px 54px rgba(4, 0, 18, 0.5);
  }

  /* 屏幕网格底纹 */
  .eva-screen::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background-image: linear-gradient(rgba(190, 160, 255, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(190, 160, 255, 0.08) 1px, transparent 1px);
    background-size: 42px 42px;
  }

  /* —— 装甲分片：默认（无 JS）即完整机体 —— */
  .eva-piece {
    position: absolute;
    z-index: 1;
    width: 20%;
    height: 20%;
    left: calc(var(--cx) * 20%);
    top: calc(var(--cy) * 20%);
    background-image: var(--eva-img);
    background-size: 500% 500%;
    background-position: calc(var(--cx) / 4 * 100%) calc(var(--cy) / 4 * 100%);
    will-change: transform, opacity;
  }

  /* JS 接管后先清场，等待滚动组装 */
  .eva.is-live .eva-piece {
    opacity: 0;
  }

  /* 落位闪光：橙色装甲锁定 */
  .eva-piece.is-locked {
    animation: eva-lock 0.42s var(--ease-out);
  }

  @keyframes eva-lock {
    0% {
      outline: 2px solid rgba(255, 138, 26, 0.9);
      outline-offset: -1px;
      filter: brightness(1.8);
    }
    100% {
      outline: 2px solid rgba(255, 138, 26, 0);
      outline-offset: -1px;
      filter: none;
    }
  }

  /* 待机扫描线：屏幕保持"通电"感 */
  .eva-sweep {
    position: absolute;
    left: 0;
    right: 0;
    top: -20%;
    height: 88px;
    z-index: 2;
    background: linear-gradient(180deg, transparent, rgba(179, 157, 255, 0.08), transparent);
    animation: eva-sweep 7s linear infinite;
    pointer-events: none;
  }

  @keyframes eva-sweep {
    to {
      top: 120%;
    }
  }
</style>

<script>
  // 滚动驱动的组装循环：
  // - 进度 = 屏幕在视口中的位置（0 隐藏 → 1 组装完毕），可随滚动反向拆解
  // - 每片按距中心的顺序错峰就位，轻微过冲模拟装甲"咔哒"锁定
  const clamp01 = (v: number) => Math.min(1, Math.max(0, v));
  const easeOutBack = (t: number) => {
    const c1 = 0.9;
    return 1 + (c1 + 1) * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
  };
  // 确定性伪随机：同一片每次计算方向一致
  const rnd = (i: number, salt: number) => {
    let h = (Math.imul(i + 1, 374761393) ^ Math.imul(salt + 1, 668265263)) >>> 0;
    h = Math.imul(h ^ (h >>> 13), 1274126177) >>> 0;
    return ((h ^ (h >>> 16)) >>> 0) / 4294967296;
  };

  const initEva = () => {
    const root = document.querySelector<HTMLElement>('[data-eva]');
    if (!root || root.dataset.evaBound) return;
    root.dataset.evaBound = '1';

    const screen = root.querySelector<HTMLElement>('[data-eva-screen]');
    const statusEl = root.querySelector<HTMLElement>('[data-eva-status]');
    const syncEl = root.querySelector<HTMLElement>('[data-eva-sync]');
    const els = [...root.querySelectorAll<HTMLElement>('[data-eva-piece]')];
    if (!screen || els.length === 0) return;

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    // 预计算每片的飞入方向 / 距离 / 就位窗口
    const pieces = els.map((el, i) => {
      const angle = rnd(i, 1) * Math.PI * 2;
      const dist = 90 + rnd(i, 2) * 120;
      return {
        el,
        dx: Math.cos(angle) * dist,
        dy: Math.sin(angle) * dist * 0.82,
        rot: (rnd(i, 3) - 0.5) * 44,
        start: 0.04 + parseFloat(el.style.getPropertyValue('--o') || '0') * 0.5,
        dur: 0.42,
        locked: false,
      };
    });

    root.classList.add('is-live');
    root.dataset.state = 'standby';

    let cur = 0;
    let raf = 0;

    const apply = () => {
      for (const p of pieces) {
        const t = clamp01((cur - p.start) / p.dur);
        const e = easeOutBack(t);
        p.el.style.opacity = String(Math.min(1, t * 2));
        p.el.style.transform = `translate3d(${(p.dx * (1 - e)).toFixed(1)}px, ${
          (p.dy * (1 - e)).toFixed(1)
        }px, 0) rotate(${(p.rot * (1 - e)).toFixed(2)}deg) scale(${(0.92 + 0.08 * e).toFixed(3)})`;
        if (t >= 1 && !p.locked) {
          p.locked = true;
          p.el.classList.add('is-locked');
          window.setTimeout(() => p.el.classList.remove('is-locked'), 440);
        } else if (t < 1) {
          p.locked = false;
        }
      }
      if (syncEl) syncEl.textContent = `SYNC ${String(Math.round(cur * 100)).padStart(3, '0')}%`;
      if (statusEl) {
        statusEl.textContent = cur < 0.02 ? 'STANDBY' : cur > 0.985 ? 'ACTIVE' : 'ASSEMBLING';
      }
      root.dataset.state = cur < 0.02 ? 'standby' : cur > 0.985 ? 'active' : 'assembly';
    };

    const tick = () => {
      const rect = screen.getBoundingClientRect();
      const vh = window.innerHeight || 1;
      const target = clamp01((vh * 0.86 - rect.top) / (vh * 0.52));
      cur += (target - cur) * 0.14;
      if (Math.abs(target - cur) < 0.0015) cur = target;
      apply();
    };

    const loop = () => {
      tick();
      raf = requestAnimationFrame(loop);
    };

    // 只在屏幕附近可见时运转
    if (!('IntersectionObserver' in window)) {
      loop();
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        const visible = entries[0]?.isIntersecting;
        if (visible && !raf) {
          raf = requestAnimationFrame(loop);
        } else if (!visible && raf) {
          cancelAnimationFrame(raf);
          raf = 0;
        }
      },
      { rootMargin: '30% 0px 30% 0px' }
    );
    io.observe(screen);
  };

  document.addEventListener('astro:page-load', initEva);
</script>
