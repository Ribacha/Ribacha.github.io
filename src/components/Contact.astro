---
import Emblem from './Emblem.astro';

// 联系面板 + 页脚
---

<section id="contact" class="panel">
  <div class="container contact-wrap">
    <p class="panel-eyebrow reveal"><Emblem size={14} /> Contact · 联系我</p>
    <h2 class="panel-title reveal" style="--d:1">来找我玩</h2>
    <p class="panel-desc reveal" style="--d:2">想聊 iOS，或者只是打个招呼，都欢迎。</p>
    <div class="contact-actions reveal" style="--d:3">
      <a
        class="btn btn-primary"
        href="https://github.com/Ribacha"
        target="_blank"
        rel="noopener noreferrer"
      >
        GitHub @Ribacha
      </a>
      <a class="btn btn-ghost" href="mailto:out13572034101@qq.com">写封邮件</a>
    </div>
  </div>
</section>

<footer class="site-footer">
  <div class="container footer-inner">
    <p>© {new Date().getFullYear()} Loky · lokykkxx.cn</p>
    <p>
      Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a>
      · Hosted on
      <a href="https://pages.github.com" target="_blank" rel="noopener noreferrer">GitHub Pages</a>
    </p>
  </div>
</footer>

<style>
  .contact-wrap {
    text-align: center;
  }

  .contact-wrap .panel-eyebrow {
    justify-content: center;
  }

  .contact-wrap .panel-eyebrow::after {
    display: none;
  }

  .contact-wrap .panel-title::after {
    margin-left: auto;
    margin-right: auto;
    background: linear-gradient(90deg, rgba(255, 138, 26, 0), var(--accent), rgba(255, 138, 26, 0));
  }

  .contact-wrap .panel-desc {
    margin-left: auto;
    margin-right: auto;
  }

  .contact-actions {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 16px;
  }

  .btn {
    padding: 14px 34px;
    border-radius: 999px;
    font-size: 15.5px;
    font-weight: 600;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out),
      background 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  .btn-primary {
    background: linear-gradient(135deg, #241543, #150d26);
    border: 1px solid rgba(255, 138, 26, 0.55);
    color: var(--accent);
    letter-spacing: 0.08em;
    box-shadow: 0 0 28px rgba(255, 138, 26, 0.15), inset 0 0 14px rgba(255, 138, 26, 0.06);
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 138, 26, 0.9);
    box-shadow: 0 0 44px rgba(255, 138, 26, 0.3), inset 0 0 18px rgba(255, 138, 26, 0.1);
  }

  .btn-ghost {
    border: 1px solid var(--border);
    background: rgba(28, 18, 54, 0.7);
    color: var(--text);
  }

  .btn-ghost:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 138, 26, 0.5);
    color: var(--accent);
  }

  .site-footer {
    border-top: 1px solid var(--border);
    padding: 36px 0 44px;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: var(--text-tertiary);
  }

  .footer-inner a {
    color: var(--text-secondary);
  }

  .footer-inner a:hover {
    color: var(--accent);
  }
</style>
