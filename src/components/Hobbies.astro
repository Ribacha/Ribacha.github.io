---
import Emblem from './Emblem.astro';

// 个人喜好面板：动漫三部曲 + 日常
const hobbies = [
  {
    no: '壹',
    title: '动漫',
    text: '烙印战士、MEGALO BOX、鬼灭之刃——剑、铁拳与日轮。站里的纹章、火星与切角，就是它们留下的印记。',
  },
  {
    no: '贰',
    title: '咖啡',
    text: '永远差一杯。写代码的燃料，灵感的中转站。',
  },
  {
    no: '叁',
    title: '折腾工具',
    text: '键盘、快捷键、效率软件与各种轮子——工具折腾到极致，也是一种浪漫。',
  },
  {
    no: '肆',
    title: '电影与音乐',
    text: '写代码时来点 Lo-fi，休息时来部片子。连 Spotify 界面都复刻了，听歌当然要有仪式感。',
  },
];
---

<section id="hobbies" class="panel">
  <div class="container">
    <p class="panel-eyebrow reveal"><Emblem size={14} /> Hobbies · 个人喜好</p>
    <h2 class="panel-title reveal" style="--d:1">代码之外</h2>
    <p class="panel-desc reveal" style="--d:2">不写代码的时候，大概在干这些事。</p>
    <div class="card-grid">
      {
        hobbies.map((h, i) => (
          <article class="card reveal" style={`--d:${i + 1}`}>
            <div class="card-top">
              <span class="card-no">{h.no}</span>
              <span class="card-line" aria-hidden="true" />
            </div>
            <h3 class="card-title">{h.title}</h3>
            <p class="card-text">{h.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
