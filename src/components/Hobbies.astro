---
import Emblem from './Emblem.astro';

// 个人喜好面板：动漫 + 日常（首屏照片墙的注脚）
const hobbies = [
  {
    no: '壹',
    title: '动漫',
    text: '烙印战士、进击的巨人、MEGALO BOX、鬼灭之刃——首屏那面墙就是证物。',
  },
  {
    no: '贰',
    title: '咖啡',
    text: '请我喝一杯咖啡好吗？（最好是抹茶星冰乐超大杯呦）',
    href: '/coffee/',
  },
  {
    no: '叁',
    title: '折腾工具',
    text: '键盘、快捷键与各种轮子，折腾到极致也是一种浪漫。',
  },
  {
    no: '肆',
    title: '电影与音乐',
    text: '写代码来点 Lo-fi，休息来部片子。',
  },
];
---

<section id="hobbies" class="panel">
  <div class="container">
    <p class="panel-eyebrow reveal"><Emblem size={14} /> Hobbies · 个人喜好</p>
    <h2 class="panel-title reveal" style="--d:1">代码之外</h2>
    <p class="panel-desc reveal" style="--d:2">不写代码的时候，大概在干这些事。</p>
    <div class="card-grid">
      {
        hobbies.map((h, i) => {
          const inner = (
            <>
              {h.href && (
                <span class="card-go" aria-hidden="true">
                  ↗
                </span>
              )}
              <div class="card-top">
                <span class="card-no">{h.no}</span>
                <span class="card-line" aria-hidden="true" />
              </div>
              <h3 class="card-title">{h.title}</h3>
              <p class="card-text">{h.text}</p>
            </>
          );
          return h.href ? (
            <a class="card card-link reveal" style={`--d:${i + 1}`} href={h.href}>
              {inner}
            </a>
          ) : (
            <article class="card reveal" style={`--d:${i + 1}`}>
              {inner}
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* 可点击的卡片（如咖啡 → 请我喝咖啡）：右上角小箭头 */
  .card-link {
    color: inherit;
  }

  .card-go {
    position: absolute;
    top: 22px;
    right: 24px;
    font-size: 15px;
    color: var(--text-tertiary);
    transition: transform 0.35s var(--ease-out), color 0.35s ease;
  }

  .card-link:hover .card-go {
    transform: translate(3px, -3px);
    color: var(--accent);
  }
</style>
