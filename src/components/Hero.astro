---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import LokyMark from './LokyMark.astro';

// 照片墙：倾斜的海平面（EVA 深紫），立方体如海浪一波接一波
// 沿斜 Z 轴"抽动"立起再落回，12 个虚拟点位随机占 4-5 个并轮换
const mods = import.meta.glob<{ default: ImageMetadata }>('../assets/wall/*.jpg', {
  eager: true,
});

const tiles = [
  { file: '01-guts-light.jpg', caption: '烙印战士', alt: '烙印战士：花瓣与光中伸手的格斯' },
  { file: '02-guts-griffith.jpg', caption: '烙印战士', alt: '烙印战士：格斯与格里菲斯' },
  { file: '03-megalo-joe.jpg', caption: 'MEGALO BOX', alt: 'MEGALO BOX：装甲侧影的 Joe' },
  { file: '04-griffith-wing.jpg', caption: '烙印战士', alt: '烙印战士：光翼的格里菲斯水彩' },
  { file: '05-uzui-sun.jpg', caption: '鬼灭之刃', alt: '鬼灭之刃：日轮之下的音柱' },
  { file: '06-levi-kenny.jpg', caption: '进击的巨人', alt: '进击的巨人：利威尔与肯尼' },
  { file: '07-griffith-smile.jpg', caption: '烙印战士', alt: '烙印战士：微笑的格里菲斯' },
  { file: '08-guts-snow.jpg', caption: '烙印战士', alt: '烙印战士：雪原中举剑的格斯' },
  { file: '09-levi-eren.jpg', caption: '进击的巨人', alt: '进击的巨人：利威尔与艾伦' },
  { file: '10-megalo-red.jpg', caption: 'MEGALO BOX', alt: 'MEGALO BOX：红色海报艺术' },
].map((t) => ({ ...t, src: mods[`../assets/wall/${t.file}`].default }));

const initialSlots = [1, 8, 3, 10, 5];
const wallData = JSON.stringify({
  urls: tiles.map((t) => t.src.src),
  alts: tiles.map((t) => t.alt),
  captions: tiles.map((t) => t.caption),
});

// 花瓣：致敬「烙印战士」的光中花瓣
const petals = Array.from({ length: 10 }, (_, i) => ({
  x: (i * 89 + 7) % 100,
  delay: ((i * 1.9) % 11).toFixed(1),
  dur: (12 + ((i * 5) % 4) * 2.4).toFixed(1),
  s: (0.7 + ((i * 13) % 10) / 12).toFixed(2),
}));
---

<section id="hero" class="hero">
  <div class="hero-glow-a" aria-hidden="true"></div>
  <div class="hero-glow-b" aria-hidden="true"></div>
  {
    petals.map((p) => (
      <span
        class="petal"
        aria-hidden="true"
        style={`--x:${p.x}%; --delay:${p.delay}s; --dur:${p.dur}s; --s:${p.s};`}
      />
    ))
  }

  {/* —— 倾斜的海平面：立方体波浪 —— */}
  <div class="wall-tilt">
    <div class="wall-plane">
      <div class="wall-grid" aria-hidden="true">
        {Array.from({ length: 12 }).map(() => <span class="slot" />)}
      </div>
      <div class="cubes" data-wave-wall>
        {
          initialSlots.map((slot, i) => (
            <div class="cube-pos" data-slot={slot}>
              <div class="cube" data-img={i}>
                <div class="face face-top" />
                <div class="face face-right" />
                <figure class="face face-front">
                  <Image
                    src={tiles[i].src}
                    alt={tiles[i].alt}
                    width={560}
                    format="webp"
                    quality={78}
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                  <figcaption>{tiles[i].caption}</figcaption>
                </figure>
              </div>
              <div class="cube-shadow" />
            </div>
          ))
        }
      </div>
    </div>
  </div>
  <div class="wall-haze" aria-hidden="true"></div>
  <script type="application/json" data-wall-data set:html={wallData} />

  {/* —— LOKY：贴在过渡带上方，不浮动 —— */}
  <div class="container hero-main">
    <h1 class="hero-title" aria-label="Loky">
      <LokyMark />
    </h1>
  </div>

  {/* —— 右下角信息区 —— */}
  <div class="hero-corner">
    <p class="hero-subtitle">iOS 开发者</p>
    <p class="hero-quote">「千磨万击还坚劲，任尔东西南北风。」</p>
    <a class="hero-cta" href="#identity">开始了解 ↓</a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: 56px 0 120px;
    overflow: hidden;
  }

  /* —— 柔光：紫为主，一点 EVA 橙 —— */
  .hero-glow-a {
    position: absolute;
    top: -16%;
    left: 50%;
    transform: translateX(-50%);
    width: min(76vmin, 660px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(140, 90, 255, 0.26), rgba(140, 90, 255, 0) 65%);
    filter: blur(28px);
    pointer-events: none;
  }

  .hero-glow-b {
    position: absolute;
    bottom: -14%;
    right: -10%;
    width: 44vmax;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(255, 138, 26, 0.1), rgba(255, 138, 26, 0) 62%);
    filter: blur(30px);
    pointer-events: none;
  }

  /* —— 花瓣 —— */
  .petal {
    position: absolute;
    top: -4%;
    left: var(--x);
    width: calc(12px * var(--s));
    height: calc(12px * var(--s));
    background: linear-gradient(135deg, #e8b8dd, #c88fc0);
    border-radius: 72% 0 72% 0;
    opacity: 0;
    pointer-events: none;
    animation: petal-fall var(--dur) linear var(--delay) infinite;
  }

  @keyframes petal-fall {
    0% {
      transform: translate(0, 0) rotate(0deg);
      opacity: 0;
    }
    8% {
      opacity: 0.8;
    }
    55% {
      transform: translate(30px, 34vh) rotate(200deg);
    }
    100% {
      transform: translate(56px, 68vh) rotate(330deg);
      opacity: 0;
    }
  }

  /* ============================================================
     海平面：透视 + 倾斜的墙面，立方体沿斜 Z 轴抽动
     ============================================================ */
  .wall-tilt {
    position: relative;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px;
    perspective: 1150px;
    perspective-origin: 50% 18%;
  }

  .wall-plane {
    position: relative;
    transform: rotateX(24deg);
    transform-style: preserve-3d;
  }

  .wall-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 24px;
  }

  .slot {
    aspect-ratio: 1;
  }

  .cubes {
    position: absolute;
    inset: 0;
    transform-style: preserve-3d;
  }

  .cube-pos {
    position: absolute;
    left: 0;
    top: 0;
    opacity: 0;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .cubes[data-ready] .cube-pos {
    opacity: 1;
  }

  .cube {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    will-change: transform;
  }

  .face {
    position: absolute;
  }

  /* 正面：照片（深紫玻璃相框） */
  .face-front {
    inset: 0;
    border-radius: 16px;
    overflow: hidden;
    background: #170f2e;
    border: 1px solid rgba(190, 160, 255, 0.32);
    box-shadow: 0 26px 54px rgba(4, 0, 18, 0.6);
    backface-visibility: hidden;
    cursor: pointer;
  }

  .face-front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .face-front figcaption {
    position: absolute;
    inset: auto 0 0 0;
    padding: 30px 12px 11px;
    font-size: 12.5px;
    font-weight: 550;
    letter-spacing: 0.1em;
    color: #fff;
    background: linear-gradient(transparent, rgba(16, 8, 32, 0.78));
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.35s var(--ease-out), transform 0.35s var(--ease-out);
  }

  .face-front:hover figcaption {
    opacity: 1;
    transform: none;
  }

  /* 顶面：立方体厚度（受光更亮） */
  .face-top {
    left: 2%;
    width: 96%;
    height: 24px;
    bottom: 100%;
    transform-origin: 50% 100%;
    transform: rotateX(90deg);
    background: linear-gradient(180deg, #55408c, #2c1c54);
    border: 1px solid rgba(200, 170, 255, 0.4);
    border-radius: 5px 5px 0 0;
  }

  /* 右侧面：立方体厚度（背光更暗） */
  .face-right {
    top: 2%;
    height: 96%;
    width: 24px;
    left: 100%;
    transform-origin: 0% 50%;
    transform: rotateY(90deg);
    background: linear-gradient(90deg, #261744, #100926);
    border: 1px solid rgba(200, 170, 255, 0.24);
    border-radius: 0 5px 5px 0;
  }

  /* 海面投影 */
  .cube-shadow {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 106%;
    height: 16px;
    border-radius: 50%;
    background: radial-gradient(ellipse, rgba(4, 0, 16, 0.7), transparent 70%);
    filter: blur(3px);
  }

  /* 过渡雾带：海面沉入背景，LOKY 贴在其上 */
  .wall-haze {
    position: absolute;
    left: 50%;
    bottom: 150px;
    transform: translateX(-50%);
    width: 100vw;
    height: 210px;
    background: linear-gradient(
      180deg,
      rgba(21, 13, 38, 0) 0%,
      rgba(21, 13, 38, 0.5) 50%,
      rgba(21, 13, 38, 0.88) 100%
    );
    pointer-events: none;
    z-index: 8;
  }

  /* ============================================================
     LOKY：贴在雾带上方（无浮动），右下角为信息区
     ============================================================ */
  .hero-main {
    position: relative;
    z-index: 10;
    text-align: center;
    margin-top: -30px;
  }

  .hero-title {
    line-height: 0;
    animation: rise-in 0.9s var(--ease-out) both;
  }

  /* 字标 SVG 在子组件内部，需用 :global 穿透作用域 */
  .hero-title :global(svg.loky-mark) {
    width: clamp(270px, 40vw, 430px);
    height: auto;
    filter: drop-shadow(0 0 36px rgba(140, 100, 255, 0.45))
      drop-shadow(0 18px 46px rgba(10, 4, 30, 0.6));
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* —— 右下角信息区（贴边，不浮动）—— */
  .hero-corner {
    position: absolute;
    right: clamp(20px, 6vw, 88px);
    bottom: 74px;
    z-index: 10;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 10px;
    text-align: right;
    animation: rise-in 0.9s var(--ease-out) 0.3s both;
  }

  .hero-subtitle {
    font-size: clamp(17px, 2vw, 20px);
    font-weight: 600;
    color: var(--text);
    letter-spacing: 0.22em;
  }

  .hero-quote {
    font-family: var(--font-serif);
    font-size: clamp(13px, 1.6vw, 15.5px);
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
  }

  .hero-cta {
    margin-top: 12px;
    padding: 13px 30px;
    background: rgba(30, 16, 54, 0.78);
    border: 1px solid rgba(255, 138, 26, 0.65);
    color: #ffa042;
    font-size: 14.5px;
    font-weight: 650;
    letter-spacing: 0.18em;
    /* EVA 风格：对切角面板 */
    clip-path: polygon(14px 0, 100% 0, 100% calc(100% - 14px), calc(100% - 14px) 100%, 0 100%, 0 14px);
    box-shadow: 0 0 24px rgba(255, 138, 26, 0.14);
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out),
      border-color 0.3s ease, background 0.3s ease;
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    border-color: rgba(255, 160, 66, 0.95);
    background: rgba(46, 24, 80, 0.85);
    box-shadow: 0 0 44px rgba(255, 138, 26, 0.3);
  }

  @media (max-width: 760px) {
    .hero-corner {
      position: static;
      margin: 26px auto 0;
      align-items: center;
      text-align: center;
    }
    .wall-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }
  }

  /* 无 JS 环境退化为静态网格 */
  @media (scripting: none) {
    .cubes {
      position: static;
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 24px;
    }
    .cube-pos {
      position: static !important;
      opacity: 1;
      width: auto !important;
      height: auto !important;
      aspect-ratio: 1;
      transform: none !important;
    }
    .cube {
      transform: none !important;
    }
    .face-top,
    .face-right {
      display: none;
    }
  }
</style>

<script>
  // 海洋波浪：波峰从左向右一波接一波推进
  // - 相位只由「点位水平位置 - 时间」决定，所有立方体共享同一个波，
  //   不再随机各自起伏；波峰过境时立方体沿斜 Z 轴快速"抽动"立起
  // - 墙面整体 rotateX 倾斜成海平面，Z 轴即斜向插向观者
  // - 立方体姿态恒定（补偿墙面倾角后微微朝向观者），高级、克制
  const initWaveWall = () => {
    const layer = document.querySelector('[data-wave-wall]');
    const dataEl = document.querySelector('[data-wall-data]');
    if (!layer || !dataEl || layer.dataset.bound) return;
    layer.dataset.bound = '1';

    const data = JSON.parse(dataEl.textContent);
    const cubes = [...layer.querySelectorAll('.cube')];
    const slots = [...document.querySelectorAll('.wall-grid .slot')];
    const plane = document.querySelector('.wall-plane');
    if (!cubes.length || !slots.length || !plane) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // 预加载全部图片，轮换时无闪烁
    data.urls.forEach((u) => {
      const im = new Image();
      im.src = u;
    });

    const st = cubes.map((el, i) => ({
      el,
      pos: el.closest('.cube-pos'),
      shadow: el.closest('.cube-pos').querySelector('.cube-shadow'),
      slot: +el.closest('.cube-pos').dataset.slot,
      img: +el.dataset.img,
      j: i * 0.13, // 极小抖动，打破机械感
      xn: 0,
      w: 0,
      x: 0,
      y: 0,
      tx: 0,
      ty: 0,
      cx: 0,
      cy: 0,
    }));

    let bag = [];
    const nextImg = () => {
      if (!bag.length) {
        bag = data.urls.map((_, i) => i);
        for (let k = bag.length - 1; k > 0; k--) {
          const r = Math.floor(Math.random() * (k + 1));
          [bag[k], bag[r]] = [bag[r], bag[k]];
        }
        const shown = new Set(st.map((s) => s.img));
        bag.sort((a, b) => (shown.has(a) ? 1 : 0) - (shown.has(b) ? 1 : 0));
      }
      return bag.shift();
    };

    // 用布局坐标（offset）定位，倾斜变换不影响正确性
    const place = () => {
      st.forEach((s) => {
        const cell = slots[s.slot];
        s.w = cell.offsetWidth * 0.9;
        s.x = cell.offsetLeft + cell.offsetWidth / 2;
        s.y = cell.offsetTop + cell.offsetHeight / 2;
        s.xn = plane.clientWidth > 0 ? s.x / plane.clientWidth : 0;
        s.pos.style.width = s.w + 'px';
        s.pos.style.height = s.w + 'px';
      });
      layer.dataset.ready = '1';
    };
    place();
    let resizeT;
    window.addEventListener('resize', () => {
      clearTimeout(resizeT);
      resizeT = setTimeout(place, 120);
    });

    // 入场：错峰浮现
    st.forEach((s, i) => {
      s.el.animate(
        [{ opacity: 0, filter: 'blur(8px)' }, { opacity: 1, filter: 'blur(0)' }],
        { duration: 650, delay: 120 + i * 110, easing: 'cubic-bezier(.22,1,.36,1)', fill: 'backwards' }
      );
    });

    if (reduce) {
      st.forEach((s) => {
        s.pos.style.transform = `translate3d(${s.x - s.w / 2}px, ${s.y - s.w / 2}px, 0)`;
        s.el.style.transform = 'rotateX(-10deg) rotateY(-13deg)';
      });
      return;
    }

    // 指针倾斜
    st.forEach((s) => {
      const face = s.el.querySelector('.face-front');
      face.addEventListener('pointermove', (e) => {
        const r = face.getBoundingClientRect();
        s.tx = ((e.clientY - r.top) / r.height - 0.5) * 9;
        s.ty = ((e.clientX - r.left) / r.width - 0.5) * 11;
      });
      face.addEventListener('pointerleave', () => {
        s.tx = 0;
        s.ty = 0;
      });
    });

    // 海洋波浪主循环
    const PLANE_TILT = 24; // 与 CSS .wall-plane 的 rotateX 保持一致
    const Z_AMP = 200; // 浪高（px，沿斜 Z 轴）
    const WAVE_T = 2600; // 一个波推进的周期（ms）
    const WAVE_K = 2.1; // 墙面同屏可见的波数
    const t0 = performance.now();
    const tick = (now) => {
      const t = now - t0;
      for (const s of st) {
        const ph = (s.xn * WAVE_K - t / WAVE_T) * Math.PI + s.j;
        let wave = Math.sin(ph); // -1..1
        // 尖峰化：波形变窄，波峰过境时快速抽动立起，随后落回海面
        wave = Math.sign(wave) * Math.pow(Math.abs(wave), 2.4);
        const k = Math.max(0, wave); // 0 海面 .. 1 浪尖
        const z = k * Z_AMP;
        s.cx += (s.tx - s.cx) * 0.12;
        s.cy += (s.ty - s.cy) * 0.12;
        const rx = -PLANE_TILT + 14 + s.cx - k * 7; // 浪尖时轻微后仰
        const ry = -13 + s.cy;
        s.pos.style.transform = `translate3d(${s.x - s.w / 2}px, ${s.y - s.w / 2}px, ${z}px)`;
        s.pos.style.zIndex = String(Math.round(300 + z));
        s.el.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
        s.el.style.opacity = (0.72 + k * 0.28).toFixed(3);
        if (s.shadow) {
          s.shadow.style.opacity = (0.2 + k * 0.4).toFixed(3);
          s.shadow.style.transform = `scaleX(${(0.72 + k * 0.5).toFixed(3)})`;
        }
      }
      requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);

    // 轮播：随机一块淡出 → 新点位 + 新图片
    setInterval(() => {
      const s = st[Math.floor(Math.random() * st.length)];
      const occupied = new Set(st.map((x) => x.slot));
      const free = slots.map((_, i) => i).filter((i) => !occupied.has(i));
      if (!free.length) return;
      const ns = free[Math.floor(Math.random() * free.length)];
      const ni = nextImg();
      s.el
        .animate(
          [{ opacity: 1 }, { opacity: 0, filter: 'blur(6px)' }],
          { duration: 260, easing: 'ease-in' }
        )
        .onfinish = () => {
          s.slot = ns;
          s.img = ni;
          place();
          const img = s.el.querySelector('img');
          img.src = data.urls[ni];
          img.alt = data.alts[ni];
          s.el.querySelector('figcaption').textContent = data.captions[ni];
          s.el.animate(
            [{ opacity: 0, filter: 'blur(6px)' }, { opacity: 1, filter: 'blur(0)' }],
            { duration: 420, easing: 'cubic-bezier(.22,1,.36,1)' }
          );
        };
    }, 3200);
  };

  document.addEventListener('astro:page-load', initWaveWall);
</script>
