---
// 首屏：日轮背景（鬼灭）+ 火星飘粒 + 字符级渐入 + 滚动视差
const name = 'Loky';
// 火星粒子参数由索引确定，服务端生成，无随机抖动
const embers = Array.from({ length: 14 }, (_, i) => ({
  x: (i * 71 + 13) % 100,
  delay: ((i * 1.37) % 9).toFixed(1),
  dur: (9 + ((i * 7) % 5) * 1.9).toFixed(1),
  scale: (0.6 + ((i * 11) % 10) / 14).toFixed(2),
}));
---

<section id="hero" class="hero">
  <!-- 日轮：致敬鬼灭之刃的巨日 -->
  <div class="hero-sun" aria-hidden="true"></div>
  <!-- 火星飘粒：烙印蚀刻、日轮飞散、机箱余烬 -->
  {
    embers.map((e) => (
      <span
        class="ember"
        aria-hidden="true"
        style={`--x:${e.x}%; --delay:${e.delay}s; --dur:${e.dur}s; --s:${e.scale};`}
      />
    ))
  }

  <div class="hero-inner container">
    <p class="hero-eyebrow">剑 · 日轮 · 铁拳</p>
    <h1 class="hero-title" aria-label={name} transition:persist>
      {
        name.split('').map((ch, i) => (
          <span class="char" style={`--i:${i}`} aria-hidden="true">
            {ch}
          </span>
        ))
      }
    </h1>
    <p class="hero-subtitle">iOS 开发者</p>
    <p class="hero-quote">「千磨万击还坚劲，任尔东西南北风。」</p>
    <a class="hero-cta" href="#identity">开始了解 ↓</a>
  </div>

  <div class="hero-scroll-cue" aria-hidden="true">
    <span class="cue-dot"></span>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    text-align: center;
  }

  /* —— 日轮：巨日悬浮于标题之后 —— */
  .hero-sun {
    position: absolute;
    top: 9%;
    left: 50%;
    width: min(74vmin, 660px);
    aspect-ratio: 1;
    transform: translateX(-50%);
    border-radius: 50%;
    background: radial-gradient(
      circle at 50% 46%,
      rgba(255, 158, 84, 0.5),
      rgba(224, 73, 47, 0.26) 46%,
      rgba(176, 47, 34, 0.1) 62%,
      transparent 72%
    );
    filter: blur(10px);
    pointer-events: none;
    animation: sun-pulse 7s ease-in-out infinite;
  }

  @keyframes sun-pulse {
    50% {
      opacity: 0.82;
      transform: translateX(-50%) scale(1.045);
    }
  }

  /* —— 火星飘粒：自下而上 drifting —— */
  .ember {
    position: absolute;
    bottom: -2%;
    left: var(--x);
    width: calc(4px * var(--s));
    height: calc(4px * var(--s));
    border-radius: 50%;
    background: radial-gradient(circle, #ffb37a, #e0492f 70%);
    box-shadow: 0 0 8px rgba(224, 73, 47, 0.8);
    opacity: 0;
    pointer-events: none;
    animation: ember-rise var(--dur) linear var(--delay) infinite;
  }

  @keyframes ember-rise {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    8% {
      opacity: 0.9;
    }
    60% {
      transform: translate(24px, -46vh);
      opacity: 0.55;
    }
    100% {
      transform: translate(46px, -78vh);
      opacity: 0;
    }
  }

  .hero-inner {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding-top: 48px;
  }

  .hero-eyebrow {
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.32em;
    color: var(--text-secondary);
  }

  .hero-title {
    font-size: clamp(64px, 15vw, 148px);
    font-weight: 750;
    letter-spacing: -0.03em;
    line-height: 1.05;
    white-space: nowrap;
    text-shadow: 0 0 80px rgba(224, 73, 47, 0.35);
  }

  /* 字符级渐入 */
  .hero-title .char {
    display: inline-block;
    opacity: 0;
    transform: translateY(46px) rotate(4deg);
    animation: char-in 0.9s var(--ease-out) forwards;
    animation-delay: calc(var(--i) * 90ms + 250ms);
    will-change: transform, opacity;
  }

  @keyframes char-in {
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero-subtitle {
    font-size: clamp(18px, 2.4vw, 24px);
    font-weight: 500;
    color: var(--text-secondary);
    animation: rise-in 0.9s var(--ease-out) both;
    animation-delay: 0.85s;
  }

  /* 座右铭：衬线体，古典气质 */
  .hero-quote {
    font-family: var(--font-serif);
    font-size: clamp(15px, 1.9vw, 18px);
    letter-spacing: 0.08em;
    color: var(--text-tertiary);
    animation: rise-in 0.9s var(--ease-out) both;
    animation-delay: 1s;
  }

  .hero-cta {
    margin-top: 26px;
    padding: 14px 34px;
    border-radius: 999px;
    background: linear-gradient(135deg, var(--accent), var(--accent-deep));
    color: #fff;
    font-size: 16px;
    font-weight: 600;
    box-shadow: 0 8px 30px rgba(224, 73, 47, 0.25);
    animation: rise-in 0.9s var(--ease-out) both;
    animation-delay: 1.15s;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out);
  }

  .hero-cta:hover {
    transform: translateY(-2px);
    box-shadow: 0 14px 40px rgba(224, 73, 47, 0.4);
  }

  @keyframes rise-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* 向下滚动提示：呼吸的小圆点 */
  .hero-scroll-cue {
    position: absolute;
    bottom: 34px;
    left: 50%;
    transform: translateX(-50%);
    animation: rise-in 1s var(--ease-out) 1.6s both;
  }

  .cue-dot {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 12px rgba(224, 73, 47, 0.8);
    animation: cue-breathe 2.2s ease-in-out infinite;
  }

  @keyframes cue-breathe {
    0%,
    100% {
      transform: translateY(0);
      opacity: 0.45;
    }
    50% {
      transform: translateY(10px);
      opacity: 1;
    }
  }
</style>

<script>
  // 滚动视差：首屏内容随滚动轻微上移并淡出（Apple 产品页质感）
  const initParallax = () => {
    const hero = document.getElementById('hero');
    const inner = hero?.querySelector<HTMLElement>('.hero-inner');
    if (!hero || !inner || inner.dataset.parallaxBound) return;
    inner.dataset.parallaxBound = '1';
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    let ticking = false;
    const update = () => {
      ticking = false;
      const y = window.scrollY;
      if (y < window.innerHeight) {
        inner.style.transform = `translateY(${y * 0.22}px)`;
        inner.style.opacity = String(Math.max(0, 1 - y / (window.innerHeight * 0.7)));
      }
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(update);
        }
      },
      { passive: true }
    );
  };

  document.addEventListener('astro:page-load', initParallax);
</script>
