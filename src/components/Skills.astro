---
import Emblem from './Emblem.astro';

// 技能面板：以 iOS 为基准分组
const groups = [
  {
    label: '语言与框架',
    items: ['Objective-C', 'Objective-C++', 'UIKit', 'Foundation', 'Core Animation'],
  },
  {
    label: '底层与工程',
    items: ['Runtime', '内存管理', '多线程', 'Instruments', 'Git'],
  },
  {
    label: '正在探索',
    items: ['Swift', 'SwiftUI', 'RAG', 'Agent'],
  },
];
---

<section id="skills" class="panel">
  <div class="container">
    <p class="panel-eyebrow reveal"><Emblem size={14} /> Skills · 技能</p>
    <h2 class="panel-title reveal" style="--d:1">工具箱里有什么</h2>
    <p class="panel-desc reveal" style="--d:2">
      不追热点，一个一个学扎实。围绕 iOS，从框架到底层，再到正在打开的新地图。
    </p>
    <div class="skill-groups">
      {
        groups.map((group, gi) => (
          <div class="skill-group reveal" style={`--d:${gi + 1}`}>
            <h3 class="group-label">{group.label}</h3>
            <ul class="pill-list">
              {group.items.map((item, ii) => (
                <li class="pill" style={`--d:${gi + ii}`}>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .group-label {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 16px;
  }

  .group-label::after {
    content: '';
    flex: 1;
    max-width: 80px;
    height: 1px;
    background: linear-gradient(90deg, var(--border), transparent);
  }

  .pill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pill {
    padding: 10px 22px;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    font-size: 15px;
    font-weight: 550;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out),
      border-color 0.3s ease;
  }

  .pill:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(224, 73, 47, 0.5);
  }
</style>
