---
// 技能面板：分组标签云
const groups = [
  {
    label: '语言与框架',
    items: ['Objective-C', 'Objective-C++', 'UIKit', 'Python', 'Git'],
  },
  {
    label: '计算机基础',
    items: ['数据结构与算法', '操作系统', '计算机网络', '设计模式'],
  },
  {
    label: '正在探索',
    items: ['RAG', 'Agent', 'Prompt Engineering', 'Swift'],
  },
];
---

<section id="skills" class="panel">
  <div class="container">
    <p class="panel-eyebrow reveal">Skills · 技能</p>
    <h2 class="panel-title reveal" style="--d:1">工具箱里有什么</h2>
    <p class="panel-desc reveal" style="--d:2">
      不追热点，一个一个学扎实。以下是已经在用、和正在学的东西。
    </p>
    <div class="skill-groups">
      {
        groups.map((group, gi) => (
          <div class="skill-group reveal" style={`--d:${gi + 1}`}>
            <h3 class="group-label">{group.label}</h3>
            <ul class="pill-list">
              {group.items.map((item, ii) => (
                <li class="pill" style={`--d:${gi + ii}`}>{item}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .skill-groups {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  .group-label {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-bottom: 16px;
  }

  .pill-list {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  .pill {
    padding: 10px 22px;
    border-radius: 999px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    font-size: 15px;
    font-weight: 550;
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s var(--ease-out),
      border-color 0.3s ease;
  }

  .pill:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-card-hover);
    border-color: var(--accent);
  }
</style>
