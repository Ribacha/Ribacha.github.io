---
import Emblem from './Emblem.astro';
import EvaFigure from './EvaFigure.astro';

// 项目面板：三个精选项目（图标 + 可点击直达）
// Spotify 官方风格图标（黑方块+绿圆+三道弧）、凪 App 图标（黑方块+紫字）、
// RAG 节点图图标（黑方块+琥珀节点）
const featured = [
  {
    no: '01',
    name: 'Spotify-Clone',
    desc: '用 Objective-C++ 复刻 Spotify 客户端界面与交互，练手大型 UI 工程。',
    lang: 'Objective-C++',
    href: 'https://github.com/Ribacha/Spotify-Clone-Objective-C',
    icon: 'music',
  },
  {
    no: '02',
    name: '凪 · Serenity',
    desc: 'iOS + watchOS 呼吸冥想应用：Objective-C 与 SwiftUI 双端合作项目。',
    lang: 'iOS · watchOS',
    href: null,
    tag: '合作项目 · 私有仓库',
    icon: 'nagi',
  },
  {
    no: '03',
    name: 'RAG-Agent',
    desc: 'RAG 与 Agent 实践，为 iOS 智能能力打底。',
    lang: 'Python',
    href: 'https://github.com/Ribacha/RAG-Agent',
    icon: 'rag',
  },
];
---

<section id="projects" class="panel projects-panel">
  {/* 左缘机甲位：钉死视口最左侧的装饰，允许出血裁切；滚动经过时沿接缝线重组 */}
  <div class="projects-figure-pin">
    <div class="projects-figure-sticky">
      <EvaFigure driver="#projects" />
    </div>
  </div>

  <div class="container projects-layout">
    <div class="projects-head">
      <p class="panel-eyebrow reveal"><Emblem size={14} /> Projects · 项目</p>
      <h2 class="panel-title reveal" style="--d:1">做过的东西</h2>
      <p class="panel-desc reveal" style="--d:2">三个代表作，点击图标直达仓库。</p>
    </div>

    <div class="featured-grid">
      {
        featured.map((p, i) => {
          const inner = (
            <>
              <span class="featured-icon" aria-hidden="true">
                {p.icon === 'music' && (
                  <svg viewBox="0 0 48 48" width="56" height="56">
                    <rect width="48" height="48" rx="11" fill="#0d0d0d" />
                    <circle cx="24" cy="24" r="17.5" fill="#1ed760" />
                    <path d="M13.5 20.5 C20 17.8 30 18.2 35.5 21.5" stroke="#0d0d0d" stroke-width="3.4" fill="none" stroke-linecap="round" />
                    <path d="M14.5 27 C20 24.8 28.5 25.2 33.8 28" stroke="#0d0d0d" stroke-width="3.2" fill="none" stroke-linecap="round" />
                    <path d="M15.5 33 C20 31.2 27 31.5 31.5 33.8" stroke="#0d0d0d" stroke-width="3" fill="none" stroke-linecap="round" />
                  </svg>
                )}
                {p.icon === 'nagi' && (
                  <svg viewBox="0 0 48 48" width="56" height="56">
                    <defs>
                      <linearGradient id="nagi-g" x1="0" y1="0" x2="0" y2="48" gradientUnits="userSpaceOnUse">
                        <stop offset="0" stop-color="#8a6cf0" />
                        <stop offset="1" stop-color="#241547" />
                      </linearGradient>
                    </defs>
                    <rect width="48" height="48" rx="11" fill="#0d0d0d" />
                    <rect x="3" y="3" width="42" height="42" rx="9" fill="url(#nagi-g)" />
                    <text
                      x="24"
                      y="32.5"
                      text-anchor="middle"
                      font-size="23"
                      font-weight="600"
                      fill="#fff"
                      font-family="'PingFang SC', 'Hiragino Sans GB', sans-serif"
                    >
                      凪
                    </text>
                  </svg>
                )}
                {p.icon === 'rag' && (
                  <svg viewBox="0 0 48 48" width="56" height="56">
                    <rect width="48" height="48" rx="11" fill="#0d0d0d" />
                    <rect x="3" y="3" width="42" height="42" rx="9" fill="#171130" />
                    <circle cx="15" cy="16" r="4.2" fill="#ff8c1a" />
                    <circle cx="34" cy="13" r="3.4" fill="#b39dff" />
                    <circle cx="30" cy="34" r="4.6" fill="#ff8c1a" opacity="0.9" />
                    <path d="M17.5 18.5 L31 14.5 M33 16.5 L31.5 29.5 M16.5 18.5 L27 31.5" stroke="#6f5ab8" stroke-width="1.6" />
                  </svg>
                )}
              </span>
              <span class="featured-info">
                <span class="featured-no">{p.no}</span>
                <span class="featured-name">{p.name}</span>
                <span class="featured-desc">{p.desc}</span>
                <span class="featured-lang">{p.lang}</span>
                {p.tag && <span class="featured-tag">{p.tag}</span>}
              </span>
              {p.href && <span class="featured-arrow" aria-hidden="true">↗</span>}
            </>
          );
          return p.href ? (
            <a
              class="featured-card reveal"
              style={`--d:${i + 1}`}
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              {inner}
            </a>
          ) : (
            <article class="featured-card featured-plain reveal" style={`--d:${i + 1}`}>
              {inner}
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  /* —— 左缘机甲装饰 + 内容让位 —— */
  .projects-panel {
    /* 装饰定义为面板级变量；overflow-x: clip 裁掉出血但不产生滚动容器（保住 sticky） */
    --fig-h: min(72vh, 660px);
    --fig-w: calc(var(--fig-h) * 0.769);
    position: relative;
    overflow-x: hidden;
    overflow-x: clip;
  }

  .projects-figure-pin {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: var(--fig-w);
    pointer-events: none;
    z-index: 0;
    /* 朝内容方向渐隐溶解，机甲与页面融合而非截断（黑色段需覆盖到头部右缘 ~79%） */
    -webkit-mask-image: linear-gradient(90deg, #000 80%, rgba(0, 0, 0, 0.45) 92%, transparent 99%);
    mask-image: linear-gradient(90deg, #000 80%, rgba(0, 0, 0, 0.45) 92%, transparent 99%);
  }

  .projects-figure-sticky {
    position: sticky;
    top: calc(50vh - var(--fig-h) / 2);
    width: 108%;
    margin-left: -8%; /* 向左出血：贴死屏幕边缘，只裁掉一点边缘 */
  }

  .projects-layout {
    position: relative;
    z-index: 1;
    /* 内容让位：避开左缘机甲（考虑容器居中后的剩余边距） */
    padding-left: max(
      24px,
      calc(var(--fig-w) * 0.86 + 40px - max((100vw - var(--content-width)) / 2, 0px))
    );
  }

  .featured-grid {
    grid-template-columns: 1fr;
    gap: 20px;
  }

  @media (max-width: 960px) {
    .projects-panel {
      overflow-x: visible;
    }

    .projects-figure-pin {
      position: static;
      width: auto;
    }

    .projects-figure-sticky {
      position: static;
      width: min(320px, 88%);
      margin: 4px auto 30px;
    }

    .projects-layout {
      padding-left: 24px;
      display: grid;
      grid-template-areas:
        'head'
        'cards';
    }
  }

  .featured-card {
    position: relative;
    display: flex;
    gap: 18px;
    align-items: center;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%);
    padding: 26px 24px;
    box-shadow: var(--shadow-card);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out),
      border-color 0.4s ease;
  }

  .featured-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), rgba(255, 138, 26, 0));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.55s var(--ease-out);
  }

  .featured-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(255, 138, 26, 0.5);
  }

  .featured-card:hover::before {
    transform: scaleX(1);
  }

  .featured-icon {
    flex: none;
    filter: drop-shadow(0 8px 18px rgba(0, 0, 0, 0.45));
    transition: transform 0.45s var(--ease-out);
  }

  .featured-card:hover .featured-icon {
    transform: scale(1.08) rotate(-3deg);
  }

  .featured-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
  }

  .featured-no {
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--accent);
  }

  .featured-name {
    font-size: 20px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .featured-desc {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .featured-lang {
    font-size: 12.5px;
    font-weight: 550;
    letter-spacing: 0.06em;
    color: var(--text-tertiary);
  }

  .featured-tag {
    align-self: flex-start;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-2);
    border: 1px solid rgba(179, 157, 255, 0.4);
    border-radius: 999px;
    padding: 2px 9px;
    margin-top: 2px;
  }

  .featured-arrow {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 17px;
    color: var(--text-tertiary);
    transition: transform 0.35s var(--ease-out), color 0.35s ease;
  }

  .featured-card:hover .featured-arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }
</style>
