---
import Emblem from './Emblem.astro';

// 项目面板：展示 GitHub 上的代表项目
const projects = [
  {
    no: '01',
    name: 'RAG-Agent',
    desc: 'RAG 与 Agent 实践，为 iOS 智能能力打底。',
    lang: 'Python',
    color: '#d99a26',
  },
  {
    no: '02',
    name: 'Spotify-Clone-Objective-C',
    desc: '用 Objective-C++ 复刻 Spotify 界面与交互。',
    lang: 'Objective-C++',
    color: '#7b5cd6',
  },
  {
    no: '03',
    name: 'oc-study',
    desc: 'Objective-C 学习笔记，从语法到运行时。',
    lang: 'Objective-C',
    color: '#c73a2b',
  },
  {
    no: '04',
    name: 'KKxx',
    desc: '小实验与灵感碎片。',
    lang: 'Playground',
    color: '#9d94ab',
  },
];
---

<section id="projects" class="panel">
  <div class="container">
    <p class="panel-eyebrow reveal"><Emblem size={14} /> Projects · 项目</p>
    <h2 class="panel-title reveal" style="--d:1">做过的东西</h2>
    <p class="panel-desc reveal" style="--d:2">全部开源在 GitHub 上，点击卡片查看源码。</p>
    <div class="card-grid">
      {
        projects.map((p, i) => (
          <a
            class="card project-card reveal"
            style={`--d:${i + 1}`}
            href={`https://github.com/Ribacha/${p.name}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="card-top">
              <span class="card-no">{p.no}</span>
              <span class="card-line" aria-hidden="true" />
              <span class="project-arrow" aria-hidden="true">↗</span>
            </div>
            <h3 class="card-title">{p.name}</h3>
            <p class="card-text">{p.desc}</p>
            <p class="project-lang">
              <span class="lang-dot" style={`background:${p.color}`} aria-hidden="true" />
              {p.lang}
            </p>
          </a>
        ))
      }
    </div>
    <p class="more reveal" style="--d:3">
      <a href="https://github.com/Ribacha?tab=repositories" target="_blank" rel="noopener noreferrer">
        在 GitHub 查看全部仓库 →
      </a>
    </p>
  </div>
</section>

<style>
  .project-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .project-arrow {
    font-size: 16px;
    color: var(--text-tertiary);
    transition: transform 0.35s var(--ease-out), color 0.35s ease;
  }

  .project-card:hover .project-arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  .project-lang {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 550;
    color: var(--text-secondary);
  }

  .lang-dot {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    display: inline-block;
  }

  .more {
    margin-top: 36px;
    font-size: 16px;
    font-weight: 600;
  }

  .more a {
    color: var(--accent);
  }
</style>
