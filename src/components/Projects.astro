---
import Emblem from './Emblem.astro';

// 项目面板：精选（大卡 + 图标，可点击直达）+ 其余项目
const featured = [
  {
    no: '★1',
    name: 'Spotify-Clone',
    desc: '用 Objective-C++ 复刻 Spotify 客户端界面与交互，练手大型 UI 工程。',
    lang: 'Objective-C++',
    color: '#1db954',
    href: 'https://github.com/Ribacha/Spotify-Clone-Objective-C',
    icon: 'music',
  },
  {
    no: '★2',
    name: '凪 · Serenity',
    desc: 'iOS + watchOS 呼吸冥想应用：Objective-C 与 SwiftUI 双端合作项目。',
    lang: 'iOS · watchOS',
    color: '#7a5cff',
    href: null,
    tag: '合作项目 · 私有仓库',
    icon: 'nagi',
  },
];

const projects = [
  {
    no: '01',
    name: 'RAG-Agent',
    desc: 'RAG 与 Agent 实践，为 iOS 智能能力打底。',
    lang: 'Python',
    color: '#d99a26',
  },
  {
    no: '02',
    name: 'oc-study',
    desc: 'Objective-C 学习笔记，从语法到运行时。',
    lang: 'Objective-C',
    color: '#e0704a',
  },
  {
    no: '03',
    name: 'KKxx',
    desc: '小实验与灵感碎片。',
    lang: 'Playground',
    color: '#9d94ab',
  },
];
---

<section id="projects" class="panel">
  <div class="container">
    <p class="panel-eyebrow reveal"><Emblem size={14} /> Projects · 项目</p>
    <h2 class="panel-title reveal" style="--d:1">做过的东西</h2>
    <p class="panel-desc reveal" style="--d:2">精选两个代表作，其余全部开源在 GitHub 上。</p>

    {/* —— 精选：图标 + 大卡，点击直达 —— */}
    <div class="featured-grid">
      {
        featured.map((p, i) =>
          p.href ? (
            <a
              class="featured-card reveal"
              style={`--d:${i + 1}`}
              href={p.href}
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="featured-icon" aria-hidden="true">
                {
                  p.icon === 'music' ? (
                    <svg viewBox="0 0 48 48" width="52" height="52">
                      <rect width="48" height="48" rx="12" fill="url(#eq-g)" />
                      <defs>
                        <linearGradient id="eq-g" x1="0" y1="0" x2="0" y2="48" gradientUnits="userSpaceOnUse">
                          <stop offset="0" stop-color="#1ed760" />
                          <stop offset="1" stop-color="#0e8a43" />
                        </linearGradient>
                      </defs>
                      <rect x="10" y="26" width="5" height="12" rx="2.5" fill="#fff" opacity="0.95" />
                      <rect x="18" y="19" width="5" height="19" rx="2.5" fill="#fff" opacity="0.8" />
                      <rect x="26" y="12" width="5" height="26" rx="2.5" fill="#fff" opacity="0.95" />
                      <rect x="34" y="22" width="5" height="16" rx="2.5" fill="#fff" opacity="0.8" />
                    </svg>
                  ) : (
                    <svg viewBox="0 0 48 48" width="52" height="52">
                      <defs>
                        <linearGradient id="nagi-g" x1="0" y1="0" x2="0" y2="48" gradientUnits="userSpaceOnUse">
                          <stop offset="0" stop-color="#8a6cf0" />
                          <stop offset="1" stop-color="#3d2483" />
                        </linearGradient>
                      </defs>
                      <rect width="48" height="48" rx="12" fill="url(#nagi-g)" />
                      <text
                        x="24"
                        y="33"
                        text-anchor="middle"
                        font-size="24"
                        font-weight="600"
                        fill="#fff"
                        font-family="'PingFang SC', 'Hiragino Sans GB', sans-serif"
                      >
                        凪
                      </text>
                    </svg>
                  )
                }
              </span>
              <span class="featured-info">
                <span class="featured-name">
                  {p.name}
                  {p.tag && <span class="featured-tag">{p.tag}</span>}
                </span>
                <span class="featured-desc">{p.desc}</span>
                <span class="featured-lang">
                  <i class="lang-dot" style={`background:${p.color}`} aria-hidden="true" />
                  {p.lang}
                </span>
              </span>
              {p.href && <span class="featured-arrow" aria-hidden="true">↗</span>}
            </a>
          ) : (
            <article class="featured-card featured-plain reveal" style={`--d:${i + 1}`}>
              <span class="featured-icon" aria-hidden="true">
                <svg viewBox="0 0 48 48" width="52" height="52">
                  <defs>
                    <linearGradient id="nagi-g2" x1="0" y1="0" x2="0" y2="48" gradientUnits="userSpaceOnUse">
                      <stop offset="0" stop-color="#8a6cf0" />
                      <stop offset="1" stop-color="#3d2483" />
                    </linearGradient>
                  </defs>
                  <rect width="48" height="48" rx="12" fill="url(#nagi-g2)" />
                  <text
                    x="24"
                    y="33"
                    text-anchor="middle"
                    font-size="24"
                    font-weight="600"
                    fill="#fff"
                    font-family="'PingFang SC', 'Hiragino Sans GB', sans-serif"
                  >
                    凪
                  </text>
                </svg>
              </span>
              <span class="featured-info">
                <span class="featured-name">
                  {p.name}
                  {p.tag && <span class="featured-tag">{p.tag}</span>}
                </span>
                <span class="featured-desc">{p.desc}</span>
                <span class="featured-lang">
                  <i class="lang-dot" style={`background:${p.color}`} aria-hidden="true" />
                  {p.lang}
                </span>
              </span>
            </article>
          )
        )
      }
    </div>

    {/* —— 其余项目 —— */}
    <div class="card-grid minor-grid">
      {
        projects.map((p, i) => (
          <a
            class="card project-card reveal"
            style={`--d:${i + 1}`}
            href={`https://github.com/Ribacha/${p.name}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <div class="card-top">
              <span class="card-no">{p.no}</span>
              <span class="card-line" aria-hidden="true" />
              <span class="project-arrow" aria-hidden="true">↗</span>
            </div>
            <h3 class="card-title">{p.name}</h3>
            <p class="card-text">{p.desc}</p>
            <p class="project-lang">
              <span class="lang-dot" style={`background:${p.color}`} aria-hidden="true" />
              {p.lang}
            </p>
          </a>
        ))
      }
    </div>

    <p class="more reveal" style="--d:3">
      <a href="https://github.com/Ribacha?tab=repositories" target="_blank" rel="noopener noreferrer">
        在 GitHub 查看全部仓库 →
      </a>
    </p>
  </div>
</section>

<style>
  /* —— 精选大卡 —— */
  .featured-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }

  .featured-card {
    position: relative;
    display: flex;
    gap: 20px;
    align-items: flex-start;
    background: var(--bg-elevated);
    border: 1px solid rgba(255, 138, 26, 0.28);
    clip-path: polygon(0 0, calc(100% - 18px) 0, 100% 18px, 100% 100%, 0 100%);
    padding: 26px;
    box-shadow: var(--shadow-card);
    transition: transform 0.5s var(--ease-out), box-shadow 0.5s var(--ease-out),
      border-color 0.4s ease;
  }

  .featured-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, var(--accent), rgba(255, 138, 26, 0));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.55s var(--ease-out);
  }

  .featured-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-card-hover);
    border-color: rgba(255, 138, 26, 0.5);
  }

  .featured-card:hover::before {
    transform: scaleX(1);
  }

  .featured-icon {
    flex: none;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.35));
  }

  .featured-info {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }

  .featured-name {
    font-size: 19px;
    font-weight: 700;
    letter-spacing: -0.01em;
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  .featured-tag {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--accent-2);
    border: 1px solid rgba(179, 157, 255, 0.4);
    border-radius: 999px;
    padding: 2px 9px;
    white-space: nowrap;
  }

  .featured-desc {
    font-size: 14.5px;
    color: var(--text-secondary);
  }

  .featured-lang {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 550;
    color: var(--text-secondary);
  }

  .lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    display: inline-block;
  }

  .featured-arrow {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 17px;
    color: var(--text-tertiary);
    transition: transform 0.35s var(--ease-out), color 0.35s ease;
  }

  .featured-card:hover .featured-arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  /* —— 其余项目的小卡 —— */
  .minor-grid {
    margin-top: 4px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .project-arrow {
    font-size: 16px;
    color: var(--text-tertiary);
    transition: transform 0.35s var(--ease-out), color 0.35s ease;
  }

  .project-card:hover .project-arrow {
    transform: translate(3px, -3px);
    color: var(--accent);
  }

  .project-lang {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 13px;
    font-weight: 550;
    color: var(--text-secondary);
  }

  .more {
    margin-top: 36px;
    font-size: 16px;
    font-weight: 600;
  }

  .more a {
    color: var(--accent);
  }
</style>
