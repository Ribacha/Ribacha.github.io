---
// LOKY 字标：未来风几何字形
// 蓝色渐变打底（近黑的深蓝）、45° 切角、横贯字身的科技切割线，
// O 中嵌一颗终端绿反应堆芯，字尾带blink光标——不用任何红色
---

<svg
  class="loky-mark"
  viewBox="0 0 508 150"
  fill="none"
  role="img"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="loky-ink" x1="0" y1="18" x2="0" y2="126" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#8a6cf0" />
      <stop offset="0.5" stop-color="#4a2f9a" />
      <stop offset="1" stop-color="#241547" />
    </linearGradient>
  </defs>

  <g fill="url(#loky-ink)" stroke="#b9a6ff" stroke-opacity="0.55" stroke-width="1.2" fill-rule="evenodd">
    <!-- L：科技切割线 -->
    <path d="M0 18 H26 V86 L72 92 V126 H0 Z M0 60 H26 V66 H0 Z" />
    <!-- O：切角环 + 右壁切割线 -->
    <path
      d="M118 18 H206 L232 44 V100 L206 126 H118 L92 100 V44 Z M130 42 H194 L208 56 V88 L194 102 H130 L116 88 V56 Z M196 64 H232 V70 H196 Z"
    />
    <!-- K：切割线 -->
    <path d="M252 18 H278 V50 L306 18 H344 L308 58 L350 126 H314 L288 84 L278 96 V126 H252 Z M252 60 H278 V66 H252 Z" />
    <!-- Y：切割线 -->
    <path d="M372 18 H400 L417 44 L434 18 H462 L430 70 V126 H404 V70 Z M404 82 H430 V88 H404 Z" />
  </g>

  <!-- 反应堆芯：O 中的 EVA 橙光点 -->
  <rect x="153" y="66" width="24" height="12" rx="2" fill="#ff8c1a" />
  <!-- 终端光标：会闪烁 -->
  <rect class="loky-cursor" x="482" y="112" width="26" height="13" rx="2" fill="#ff8c1a" />
</svg>
