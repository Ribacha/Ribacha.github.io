---

<svg
  class="loky-mark"
  viewBox="0 0 462 140"
  fill="none"
  role="img"
  aria-hidden="true"
>
  <defs>
    <linearGradient id="loky-ink" x1="0" y1="10" x2="0" y2="120" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#332841" />
      <stop offset="1" stop-color="#1b1420" />
    </linearGradient>
  </defs>

  <!-- L：底部刀锋斜切 -->
  <path d="M0 10 H26 V88 L76 95 V120 H0 Z" fill="url(#loky-ink)" />
  <!-- O：八角环 -->
  <path
    fill-rule="evenodd"
    d="M123 10 H187 L212 35 V95 L187 120 H123 L98 95 V35 Z M131 34 H179 L190 45 V89 L179 100 H131 L120 89 V45 Z"
    fill="url(#loky-ink)"
  />
  <!-- 贯穿 O 的朱红刀痕 -->
  <path d="M206 28 L219 38 L146 86 L133 76 Z" fill="#c73a2b" />
  <!-- K -->
  <path
    d="M243 10 H269 V44 L299 10 H333 L295 54 L337 120 H303 L277 79 L269 90 V120 H243 Z"
    fill="url(#loky-ink)"
  />
  <!-- Y -->
  <path
    d="M361 10 H389 L406 36 L423 10 H451 L419 62 V120 H393 V62 Z"
    fill="url(#loky-ink)"
  />
  <!-- 字标下的刀刃长线 -->
  <path d="M2 132 H420 L448 126 L420 138 H2 Z" fill="#c73a2b" opacity="0.85" />
</svg>
