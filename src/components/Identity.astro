---
import Emblem from './Emblem.astro';

// 个人身份面板：以 iOS 为基准，文案做减法
const cards = [
  {
    no: '01',
    title: 'iOS 开发者',
    text: 'Objective-C / Objective-C++ 主力，把界面打磨到像素级。',
  },
  {
    no: '02',
    title: '底层与原理',
    text: 'Runtime、内存管理、渲染管线——知其所以然。',
  },
  {
    no: '03',
    title: '计算机基础',
    text: '算法、操作系统、网络、设计模式，是地基。',
  },
  {
    no: '04',
    title: 'AI × iOS',
    text: '探索 RAG 与 Agent，为智能应用储备弹药。',
  },
];
---

<section id="identity" class="panel">
  <div class="container">
    <p class="panel-eyebrow reveal"><Emblem size={14} /> Identity · 个人身份</p>
    <h2 class="panel-title reveal" style="--d:1">你好，我是 Loky</h2>
    <p class="panel-desc reveal" style="--d:2">白天写 Objective-C，晚上研究底层，像磨刀一样磨自己。</p>
    <div class="card-grid">
      {
        cards.map((card, i) => (
          <article class="card reveal" style={`--d:${i + 1}`}>
            <div class="card-top">
              <span class="card-no">{card.no}</span>
              <span class="card-line" aria-hidden="true" />
            </div>
            <h3 class="card-title">{card.title}</h3>
            <p class="card-text">{card.text}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
