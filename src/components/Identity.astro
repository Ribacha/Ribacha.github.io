---
import Emblem from './Emblem.astro';
import EvaAssembly from './EvaAssembly.astro';

// 个人身份面板：左侧文案卡片，右侧 EVA-01 组装机甲位（随滚动逐块组装）
const cards = [
  {
    no: '01',
    title: 'iOS 开发者',
    text: '学习 Native，原生开发中。',
  },
  {
    no: '02',
    title: '底层与原理',
    text: 'Runtime、内存管理、渲染管线——知其所以然吗？',
  },
  {
    no: '03',
    title: '计算机基础',
    text: '算法、操作系统、计算机网络。',
  },
  {
    no: '04',
    title: 'AI × iOS',
    text: '探索 RAG 与 Agent ing。。。',
  },
];
---

<section id="identity" class="panel">
  <div class="container identity-layout">
    <div class="identity-copy">
      <p class="panel-eyebrow reveal"><Emblem size={14} /> Identity · 个人身份</p>
      <h2 class="panel-title reveal" style="--d:1">你好，我是 Loky</h2>
      <p class="panel-desc reveal" style="--d:2">一个单纯的普通的 iOS 开发者，目标是往全栈发展。</p>
      <div class="card-grid identity-cards">
        {
          cards.map((card, i) => (
            <article class="card reveal" style={`--d:${i + 2}`}>
              <div class="card-top">
                <span class="card-no">{card.no}</span>
                <span class="card-line" aria-hidden="true" />
              </div>
              <h3 class="card-title">{card.title}</h3>
              <p class="card-text">{card.text}</p>
            </article>
          ))
        }
      </div>
    </div>

    <div class="identity-mecha reveal" style="--d:3">
      <EvaAssembly />
    </div>
  </div>
</section>

<style>
  .identity-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(300px, 400px);
    gap: clamp(44px, 6vw, 88px);
    align-items: center;
  }

  /* 左栏变窄后固定两列卡片 */
  .identity-cards {
    grid-template-columns: repeat(2, 1fr);
  }

  @media (max-width: 1240px) {
    .identity-layout {
      grid-template-columns: minmax(0, 1fr) minmax(280px, 340px);
    }
  }

  @media (max-width: 980px) {
    .identity-layout {
      grid-template-columns: 1fr;
    }

    .identity-mecha {
      width: 100%;
      max-width: 400px;
      margin: 10px auto 0;
    }

    .identity-cards {
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
    }
  }
</style>
