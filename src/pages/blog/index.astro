---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Emblem from '../../components/Emblem.astro';
import { CATEGORIES, isCategory } from '../../lib/blog.ts';

// 博客首页：分类导航（二级界面第一层）
const posts = await getCollection('blog');
const counts = new Map<string, number>();
for (const post of posts) {
  counts.set(post.data.category, (counts.get(post.data.category) ?? 0) + 1);
}
const categories = Object.entries(CATEGORIES).map(([slug, meta]) => ({
  slug,
  ...meta,
  count: counts.get(slug) ?? 0,
}));
---

<Base
  title="博客 · Loky"
  description="Loky 的博客 — iOS 手记、技术笔记与随笔。"
  secondary={{ label: '博客 · 分类', back: { href: '/', label: '返回首页' } }}
>
  <section class="panel blog-head">
    <div class="container">
      <p class="panel-eyebrow reveal"><Emblem size={14} /> Blog · 博客</p>
      <h1 class="panel-title reveal" style="--d:1">选一个分类进去看看</h1>
      <p class="panel-desc reveal" style="--d:2">
        文章都躺在 Obsidian 里，同步过来后按分类归档。
      </p>
      <div class="category-grid">
        {
          categories.map((cat, i) => (
            <a
              class={`card category-card ${i % 2 === 1 ? 'alt' : ''}`}
              style={`--d:${i + 1}`}
              href={`/blog/${cat.slug}/`}
            >
              <div class="card-top">
                <span class="card-no">{String(i + 1).padStart(2, '0')}</span>
                <span class="card-line" aria-hidden="true" />
                <span class="cat-count">{cat.count} 篇</span>
              </div>
              <h2 class="card-title">
                {cat.name}
                <small>{cat.en}</small>
              </h2>
              <p class="card-text">{cat.desc}</p>
              <span class="cat-arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .blog-head {
    min-height: 72vh;
  }

  .category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 20px;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-bottom: 46px;
  }

  /* 交替紫/红顶线与编号，呼应紫晕与日轮双色 */
  .category-card.alt .card-no {
    color: var(--accent-2);
  }

  .category-card.alt::before {
    background: linear-gradient(90deg, var(--accent-2), rgba(164, 138, 232, 0));
  }

  .category-card.alt:hover {
    border-color: rgba(164, 138, 232, 0.4);
  }

  .cat-count {
    font-size: 12px;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .card-title small {
    display: block;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin-top: 4px;
  }

  .cat-arrow {
    position: absolute;
    bottom: 18px;
    right: 22px;
    font-size: 18px;
    color: var(--text-tertiary);
    transition: transform 0.35s var(--ease-out), color 0.35s ease;
  }

  .category-card:hover .cat-arrow {
    transform: translateX(6px);
    color: var(--accent);
  }
</style>
